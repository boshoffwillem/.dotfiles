{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "dart-mcp-server": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server"
      ],
      "enabled": true,
      "environment": {}
    },
    "ado": {
      "type": "local",
      "command": ["npx", "-y", "@azure-devops/mcp", "psicle", "--authentication", "azcli"],
      "enabled": true
    },
    "productboard": {
      "type": "remote",
      "url": "https://mcp.productboard.com",
      "enabled": true
    },
    "Neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "enabled": true
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    }
  }
}
