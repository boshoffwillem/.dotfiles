{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "sf-aspnetcore-mcp": {
      "type": "local",
      "command": ["dnx", "Syncfusion.AspNetCore.MCP", "--yes"],
      "enabled": true,
      "environment": {
        "Syncfusion_API_Key_Path": "/Users/boshoffwillem/.syncfusion/api-key.txt"
      }
    },
    "dart-mcp-server": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true,
      "environment": {}
    },
    "ado": {
      "type": "local",
      "command": ["npx", "-y", "@azure-devops/mcp", "psicle", "--authentication", "azcli"],
      "enabled": true
    },
    "productboard": {
      "type": "remote",
      "url": "https://mcp.productboard.com",
      "enabled": true
    }
  }
}
